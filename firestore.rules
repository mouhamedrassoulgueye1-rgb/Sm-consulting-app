rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection: readable by all visitors globally, writable by admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection: readable by all visitors globally, writable by admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
